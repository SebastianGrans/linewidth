{
  "manifest_version": 3,
  "name": "linewidth",
  "version": "0.1.0",
  "description": "Pick an HTML element on the page and step through its ancestor hierarchy.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linewidth@sebastiangrans.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "src/icons/icon.svg",
    "96": "src/icons/icon.svg"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Pick an element",
    "default_icon": "src/icons/icon.svg"
  },
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["src/icons/picker.svg", "src/icons/delete.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}

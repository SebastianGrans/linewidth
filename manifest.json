{
  "manifest_version": 3,
  "name": "linewidth",
  "version": "0.1.0",
  "description": "Pick an HTML element on the page and step through its ancestor hierarchy.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Pick an element"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["picker.svg", "delete.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}

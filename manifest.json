{
  "manifest_version": 3,
  "name": "linewidth",
  "version": "0.1.0",
  "description": "Pick an HTML element on the page and step through its ancestor hierarchy.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Pick an element"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["picker.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
